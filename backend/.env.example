# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-app.vercel.app

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bug-replier?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# AI Debugging Engine API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Platform SMTP Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL=your_email@gmail.com

# Google OAuth 2.0 (Gmail Sending Integration)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-backend-app.onrender.com/api/auth/google/callback

# Razorpay Subscription Payments (INR)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
